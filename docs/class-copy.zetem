{# 
 # this is the class ZETEM template
 #
 # $className   class name ie. patientsClass
 # $tableName   table name ie. patients
 # $fieldsList  list of fields
 #
 # $templateName name of the template
 # $templatePath path of the template
 #
 #}

 {#
    /*
    <!-- 
    *  Class Template
    *  DO NOT EDIT BY HAND. IT WILL BE OVEWRITTEN.
    *  EDIT THE ZETEM TEMPLATE INSTEAD
    *
    *  zetem template: {{$templateName}}
    *
    *  template path : {{$templatePath}}
    -->
    */ 
 <?php
     
#}
     
 {{ "<?php\n" }}

class {{$className}} extends dbAbstractEntityClass {

{% foreach($fieldsList as $fieldName): %}
    private ${{$fieldName}};
{% endforeach %}

    function __construct($adata = array() ) {
        parent::__construct("{{$tableName}}", $adata);
        $this->loadFields( $adata );
    }

    static function sgetById(int $aid) {
        $sql = "SELECT * FROM {{$tableName}} WHERE id=:id";
        $st = dbConnection::getConnection()->prepare( $sql );
        $st->bindValue(":id", $aid, PDO::PARAM_INT);
        $st->execute();
        $row = $st->fetch();
              
        if($row) {
            $rclass = new {{$className}}( "{{$tableName}}" );
            $rclass->loadFields( $row );
            return $rclass;
        } else return (null);
    }

    static function sgetAll($whereClause = null, $limit = null) {
        $sql = "SELECT * FROM {{$tableName}}";
        if($whereClause)
            $sql = $sql . " WHERE " . $whereClause;

        if($limit)
            $sql = $sql . " LIMIT " . $limit;

        $st = dbConnection::getConnection()->prepare( $sql );
        $st->execute();
          
        $list = array();
          
        while( $row = $st->fetch() ) {
            $rclass = new {{$className}}( "{{$tableName}}" );
            $rclass->loadFields( $row );
            $list[] = $rclass;
        }
          
        return ($list);
          
    }

    static function table() { return "{{$tableName}}";}

    function loadFields($adata) {
        parent::loadFields($adata);

    {% foreach($fieldsList as $fieldName): %}
        if(isset($adata[ '{{$fieldName}}' ]))$this->{{$fieldName}} = $adata[ '{{$fieldName}}' ];
    {% endforeach %}

    }

    function getFields() {
        $resp = array();
        $resp = array_merge($resp, parent::getFields());

        {% foreach($fieldsList as $fieldName): %}
            $resp = array_merge($resp, ['{{$fieldName}}' => $this->{{$fieldName}}]);
        {% endforeach %}

      return $resp;
    }

    function getAllFields() {
        $resp = array();
        $resp = array_merge($resp, parent::getAllFields());
        {% foreach($fieldsList as $fieldName): %}
            $resp = array_merge($resp, ['{{$fieldName}}' => $this->{{$fieldName}}]);
        {% endforeach %}

      return $resp;
    }


    {% foreach($fieldsList as $fieldName): %}
        function set{{$fieldName}}( $a{{$fieldName}} ) { $this->{{$fieldName}} = $a{{$fieldName}}; }
        function get{{$fieldName}}() { return $this->{{$fieldName}}; }
    {% endforeach %}

    function insert() {
        if($this->id != null) {
            echo 'Trying to insert() a record that already exists';
            return (null);
        }
  
        $sql = "INSERT INTO {{$tableName}} ( ";

        {#
            $sql .= {% implode(', ', {{$fieldsList}}) %};  -->

        #} 
        $sql .= "{% echo implode(',', $fieldsList) %}"; 

        $sql .= " ) VALUES ( ";

        $sql .= "{% echo implode(',', array_map(function($fn) {return ':'.$fn;}, $fieldsList) ) %}";

        $sql .= ");";

        $st = $this->getConnection()->prepare ( $sql );


        {% foreach($fieldsList as $fieldName): %}
            $st->bindValue( ":{{$fieldName}}", $this->{{$fieldName}}, PDO::PARAM_STR );
        {% endforeach %}

        $res = $st->execute();
        $this->setid( $this->getConnection()->lastInsertId() );
        return $res;
    }

    function update() {
        if($this->id == null) {
            echo 'Trying to update() a record that does not exist';
            return (null);
        }
      
        $sql = "UPDATE {{$tableName}} SET ";
        
        $sql .= "{% echo implode(',', array_map(function($fn) {return $fn.'=:'.$fn;}, $fieldsList) ); %}";

        $sql .= " WHERE id=:id";

        $st = $this->getConnection()->prepare ( $sql );
              
        {% foreach($fieldsList as $fieldName): %}
            $st->bindValue( ":{{$fieldName}}", $this->{{$fieldName}}, PDO::PARAM_STR );
        {% endforeach %}
        $st->bindValue( ":id", $this->id, PDO::PARAM_INT );

        return $st->execute();
    }
              

    function delete() {
        if($this->id == null) {
            echo 'Trying to delete() an empty record';
            return (null);
        }
          
        if(!$this->isdbConnected()) {
            if(!$this->getConnection()->Connect()) {
                echo 'Could not connect to database';
                return (null);
            }
        }
          
        $sql = "DELETE FROM {{$tableName}} WHERE id = :id;";
        $st = $this->getConnection()->prepare($sql);
        $st->bindValue( ":id", $this->id, PDO::PARAM_INT );
        return $st->execute();
    }
}


