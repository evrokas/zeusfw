{#
  this displays a menu
    menu structure:
    menu:
      menu_name:
        - link1:
          text: link_name
          url: link_url
          permissions: access_permissions
          attributes: div attributes
#}

    {% function show_menu($aamenu, $aalevel) { %}
        {% foreach($aamenu as $menuitem): %}
            {% if(isset($menuitem['submenu'])): %}
                <li {{attributes($menuitem)}}>
                    {% if(isset($menuitem['icon'])): %}
                        {% if(isset($menuitem['icon']['class'])): %}
                            {{ $menuitem['icon']['class'] }}
                        {% endif %}
                    {% endif %}
                    {% if(isset($menuitem['text'])): %}
                        {{$menuitem['text']}}
                    {% endif %}

                    <ul {{attributes($menuitem["drop-menu-attributes"])   }}>
                        {% show_menu($menuitem['submenu'], $aalevel+1) %}
                    </ul>
                </li>
            {% else: %}
                <li {{attributes($menuitem)}}>
                    <a href="{{(isset($menuitem['url']))?rel_url($menuitem['url']):'#';}}">
                        {% if(isset($menuitem['icon'])): %}
                            {% if(isset($menuitem['icon']['class'])): %}
                                {{ $menuitem['icon']['class'] }}
                            {% endif %}
                        {% endif %}
                        {% if(isset($menuitem['text'])): %}
                            {{$menuitem['text']}}
                        {% endif %}
                    </a>
                </li>
            {% endif %}
        {% endforeach %}
    {% } %}

<!-- { {attributes($menu->addAttribute('menu-level-0'))}} -->

<ul>
    {% show_menu($menu, 1) %}
</ul>

