    {% if(!function_exists('show_menu')) { %}
      {% function show_menu($aamenu, $aalevel) { %}
        {% foreach($aamenu as $menuitem): %}
            {% if(isset($menuitem['submenu'])): %}
                <li {{attributes($menuitem)}}>
                    {% if(isset($menuitem['url'])): %}
                        <a href="{{(isset($menuitem['url']))?rel_url($menuitem['url']):'#';}}">
                    {% endif %}

                        {% if(isset($menuitem['icon'])): %}
                            {% if(isset($menuitem['icon']['class'])): %}
                                {{ $menuitem['icon']['class'] }}
                            {% endif %}
                        {% endif %}
                        <span>
                            {% if(isset($menuitem['text'])): %}
                                {{getLangText($menuitem['text'])}}
                            {% endif %}
                            <i class="bx bx-chevron-right"></i>
                        </span>

                    {% if(isset($menuitem['url'])): %}
                        </a>
                    {% endif %}


                    <ul {{attributes($menuitem["drop-menu-attributes"])   }}>
                        {% show_menu($menuitem['submenu'], $aalevel+1) %}
                    </ul>

                </li>
            {% else: %}
                <li {{attributes($menuitem)}}>
                    <a href="{{(isset($menuitem['url']))?rel_url($menuitem['url']):'#';}}">
                        {% if(isset($menuitem['icon'])): %}
                            {% if(isset($menuitem['icon']['class'])): %}
                                {{ $menuitem['icon']['class'] }}
                            {% endif %}
                        {% endif %}
                        <span>
                            {% if(isset($menuitem['text'])): %}
                                {{getLangText($menuitem['text'])}}
                            {% endif %}
                        </span>
                    </a>
                </li>
            {% endif %}
        {% endforeach %}
      {% } %}
    {% } %}
