{#
==========================================
MENU.ZETEM - Menu Entry Point
Calls show_menu function to render menu
==========================================

Menu structure from MenuBuilder:
menu:
  - item_key:
      title: "Menu Item"
      url: "/path"
      icon: {class: "<i class='bx bx-icon'></i>"}
      badge: {text: "3", class: "badge-info"}
      children: [...]
      attributes: Attributes Object
      link_attributes: Attributes Object
      ... (17+ metadata fields)
#}

{% include show_menu.zetem %}

<ul {{ attributes($menu_attributes) }}>
    {% show_menu($menu, 1) %}
</ul>
