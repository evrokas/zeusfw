{# 
==========================================
SHOW_MENU.ZETEM - Recursive Menu Function
Pure presentation - recursive rendering only
No variant checks here!
==========================================
#}

{% if(!function_exists('show_menu')) { %}
  {% function show_menu($items, $level) { %}
    {% foreach($items as $item): %}
      <li {{ attributes($item['attributes']) }}>
        {% if($item['has_children']): %}
            {# Item with submenu #}
            <input {{ attributes($item['toggle_attributes']) }}>
          
          {% if(isset($item['url'])): %}
            {# Parent item has URL - make it clickable in label #}
            <label {{ attributes($item['toggle_label_attributes']) }}>
              <a href="{{ rel_url($item['url']) }}" {{ attributes($item['link_attributes']) }}>
                {% if(isset($item['icon'])): %}
                  <span {{ attributes(item.icon_attributes) }}>
                    {{ $item['icon']['class'] }}
                  </span>
                {% endif %}
                <span class="menu-text">
                  {{ getLangText($item['title']) }}
                </span>
                {% if(isset(item['badge'])): %}
                  <span {{ attributes($item['badge_attributes']) }}>
                    {{ $item['badge']['text'] }}
                  </span>
                {% endif %}
              </a>
              <i class="bx bx-chevron-right"></i>
            </label>
          {% else: %}
            {# Parent item is just a label #}
            <label {{ attributes($item['toggle_label_attributes']) }}>
              <span {{ attributes($item['link_attributes']) }}>
                {% if(isset($item['icon'])): %}
                  <span {{ attributes($item['icon_attributes']) }}>
                    {{ $item['icon']['class'] }}
                  </span>
                {% endif %}
                <span class="menu-text">
                  {{ getLangText($item['title']) }}
                </span>
                {% if(isset($item['badge'])): %}
                  <span {{ attributes($item['badge_attributes']) }}>
                    {{ $item['badge']['text'] }}
                  </span>
                {% endif %}
              </span>
              <i class="bx bx-chevron-right"></i>
            </label>
          {% endif %}
          
          {# Submenu dropdown #}
          {% if($item['submenu_visibility'] != 'hide'): %}
            <ul {{ attributes($item['submenu_attributes']) }}>
              {% show_menu($item['children'], $level + 1) %}
            </ul>
          {% endif %}
          
        {% else: %}
          {# Simple menu item #}
          <a href="{{ $item['url'] ? rel_url($item['url']) : '#' }}" 
             {{ attributes($item['link_attributes']) }}>
            {% if(isset($item['icon'])): %}
              <span {{ attributes($item['icon_attributes']) }}>
                {{ $item['icon']['class'] }}
              </span>
            {% endif %}
            <span class="menu-text">
              {{ getLangText($item['title']) }}
            </span>
            {% if(isset($item['badge'])): %}
              <span {{ attributes($item['badge_attributes']) }}>
                {{ $item['badge']['text'] }}
              </span>
            {% endif %}
          </a>
        {% endif %}
      </li>
    {% endforeach %}
  {% } %}
{% } %}