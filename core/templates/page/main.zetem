<!DOCTYPE html>
<html lang="en">

<head>
    {% if(isset($meta))foreach($meta as $metaline): %}
        <meta {{ $metaline }}>
    {% endforeach; %}

    {# check to see if there is title defined in yaml #}
    {% if(isset($title)): %}
        <title>{{ $title }}</title>
    {% endif %}


    {% foreach($head_links as $hlink): %}
        <link
            {% foreach($hlink as $elkey => $elval): %}
                {% foreach($elval as $el_key => $el_val): %}
                    {{ $el_key }} = 
                    {% if($el_key === "href"): %}
                        {{ rel_url($el_val) }}
                    {% else: %}
                        {{ $el_val }}
                    {% endif %}
                {% endforeach %}
            {% endforeach %}
        >
    {% endforeach %}

    {% if(isset($css))foreach($css as $csss): %}
        <link rel="stylesheet" href="{{rel_url($csss['src'])."?".time()}}">
    {% endforeach %}

    {% if(isset($head_script))foreach($head_script as $scrpt): %}
        <script type="{{$scrpt['type']}}" src="{{rel_url($scrpt['src'])}}"></script>
    {% endforeach; %}

</head>

    {% if(isset($fonts))foreach($fonts as $font): %}
    <style type="text/css">
        @font-face {
            font-family: "{{ $font['font-family'] }}";
            src: url( "{{ rel_url( $font['url']) }}" ) {% if(isset($font['format'])): %} format("{{$font['format'] }}") {% endif %};
        }
    </style>
    {% endforeach %}

  
<body>
    {% include page.zetem %}
</body>

    {% if(isset($foot_script))foreach($foot_script as $scrpt): %}
        <script 
            {% if(array_key_exists('type', $scrpt)):%}
                    type="{{$scrpt['type']}}" 
            {% endif %}
            src="{{rel_url($scrpt['src'])}}"
            {% if(array_key_exists('defer', $scrpt)): %}
                defer
            {% endif %}
        ></script>
    {% endforeach; %}
