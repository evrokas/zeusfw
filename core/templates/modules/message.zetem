
<div class="announcements">
    <div class="announce-header">
        Announcements
    </div>

    <ul>
        {% foreach($messages as $msg): %}
            <li>
                <div class="title">
                    {{$msg->getmdate()|date('d-m-y')}}: {{$msg->gettitle()}}
                </div>

                <div class="body">
                    {{$msg->getmessage()}}
                </div>
            </li>
        {% endforeach %}
    </ul>
</div>