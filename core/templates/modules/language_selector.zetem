{{ attach_library("language_selector-library") }}

<div class="language-selector" data-mode="{{ $mode }}">
    <ul>
        {% foreach($available as $lang): %}
            <li>
                {% if $mode === 'query_param' %}
                    {# Query parameter mode: Use regular links #}
                    <a href="{{ $urls[$lang] }}" class="language-link" data-lang="{{ $lang }}">
                        <img {{attributes($attributes[$lang])}} />
                    </a>
                {% else %}
                    {# AJAX mode: Use images with click handlers (existing behavior) #}
                    <img {{attributes($attributes[$lang])}} />
                {% endif %}
            </li>
        {% endforeach %}
    </ul>
</div>
